LidLoaderPlantCD(
    input String channel commandIn;
    output String channel evidenceOut;
)->{
    String command = "";
    while(true){
        receive commandIn;
        command = (String)#commandIn;
        pause;
        send evidenceOut(
            "OK|lidPresent=true|placementComplete=true|armHome=true");
    }
}

