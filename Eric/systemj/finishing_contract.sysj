LidLoaderControllerCD(
    input String channel jobIn;
    output String channel reportOut;
    output String channel plantCommandOut;
    input String channel plantEvidenceIn;
    input String channel ackIn;
)->{
    String job = "";
    String evidence = "";
    send reportOut("READY|LidLoaderController");
    while(true){
        receive jobIn;
        job = (String)#jobIn;
        if(job.startsWith(
                "START|SJ-J1|SJ-WP-001|LidLoaderController|PLACE_LID")){
            send reportOut("BUSY|SJ-J1|SJ-WP-001|LidLoaderController");
            send plantCommandOut(job);
            receive plantEvidenceIn;
            evidence = (String)#plantEvidenceIn;
            if(evidence.startsWith("OK|")){
                send reportOut(
                    "DONE|SJ-J1|SJ-WP-001|LidLoaderController|" + evidence);
                receive ackIn;
                send reportOut("READY|LidLoaderController");
            }else{
                send reportOut(
                    "FAULT|SJ-J1|SJ-WP-001|LidLoaderController|" + evidence);
            }
        }else{
            send reportOut(
                "FAULT|UNKNOWN|UNKNOWN|LidLoaderController|invalid-job");
        }
        pause;
    }
}

