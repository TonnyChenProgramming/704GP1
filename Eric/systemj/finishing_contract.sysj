LidHarnessCD(
    output String channel jobOut;
    input String channel reportIn;
    output String channel ackOut;
)->{
    String report = "";
    receive reportIn;
    send jobOut("START|SJ-J1|SJ-WP-001|LidLoaderController|PLACE_LID");
    receive reportIn;
    receive reportIn;
    report = (String)#reportIn;
    if(report.startsWith("DONE|SJ-J1|SJ-WP-001|LidLoaderController")){
        System.out.println("ERIC SYSTEMJ LID CONTRACT PASSED");
    }
    send ackOut("ACK|SJ-J1|SJ-WP-001");
    while(true){ pause; }
}

