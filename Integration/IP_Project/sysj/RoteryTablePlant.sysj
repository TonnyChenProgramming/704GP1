RotaryTablePlant(

    // controller --> plant
    input Boolean channel rotate;

    // plant --> controller
    output Boolean channel aligned;

)->{

    int rotationTraceId = 0;

    while(true){

        receive rotate;

        rotationTraceId++;

        System.out.println(
            "TRACE ROTARY_PLANT_RECEIVED" +
            " rotation=" + rotationTraceId +
            " value=" + (Boolean)#rotate +
            " ns=" + System.nanoTime()
        );

        if((Boolean)#rotate){

            // Simulate one 60-degree rotation
            waitl(500 ms);

            System.out.println(
                "TRACE ROTARY_PLANT_ROTATION_COMPLETE" +
                " rotation=" + rotationTraceId +
                " ns=" + System.nanoTime()
            );

            // Alignment is authoritative completion evidence
            send aligned(true);

            System.out.println(
                "TRACE ROTARY_PLANT_ALIGNED_SENT" +
                " rotation=" + rotationTraceId +
                " ns=" + System.nanoTime()
            );
        }

        pause;
    }
}