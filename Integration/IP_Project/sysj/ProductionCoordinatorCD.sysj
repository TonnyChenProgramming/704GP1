// Availability experiment version: EVENT-ALIGNED-V4-2026-09-13
// Production orchestration split from the frozen centralised CoordinatorCD.
// Flat parallel I/O reactions are intentionally preserved from the baseline.
// SystemJ owns concurrency/channels; ProductionCoordinatorModel owns line state.

import nz.ac.auckland.eabs.zhiyuan.coordinator.ProductionCoordinatorModel;
import nz.ac.auckland.eabs.zhiyuan.coordinator.GlobalExperiment;

ProductionCoordinatorCD(

    input String channel batchIn;

    output String channel batchEventOut;

    input String channel safetyHoldIn;

    input String channel safetyResetIn;

    output String channel safetyResetDoneOut;

    output String channel loaderJobOut;

    input String channel loaderReportIn;

    output String channel loaderAckOut;

    output String channel conveyorJobOut;

    input String channel conveyorReportIn;

    output String channel conveyorAckOut;

    output String channel fillerJobOut;

    input String channel fillerReportIn;

    output String channel fillerAckOut;

    output String channel lidJobOut;

    input String channel lidReportIn;

    output String channel lidAckOut;

    output String channel capperJobOut;

    input String channel capperReportIn;

    output String channel capperAckOut;

    output String channel labellerJobOut;

    input String channel labellerReportIn;

    output String channel labellerAckOut;

    output String channel unloaderJobOut;

    input String channel unloaderReportIn;

    output String channel unloaderAckOut;

    // Reliable Production -> RotaryController request rendezvous.
    output String channel rotationRequestOut;

    // Reliable RotaryController -> Production completion rendezvous.
    input String channel rotationDoneIn;

)->{

    ProductionCoordinatorModel signal stateModel;

    emit stateModel(new ProductionCoordinatorModel());

    pause;

    // Out-of-band PRODUCTION-local experiment clock. This reaction is NEVER halted.
    // It advances once per ProductionCoordinatorCD logical instant.
    {
        while(true){
            GlobalExperiment.clockTick("PRODUCTION");
            pause;
        }
    }
    ||


    {

        ProductionCoordinatorModel model = (ProductionCoordinatorModel)#stateModel;

        while(true){
            if(GlobalExperiment.shouldRun("PRODUCTION")){ model.tick(); 
            }
            pause;
        }

    }

    ||

    {

        ProductionCoordinatorModel model = (ProductionCoordinatorModel)#stateModel;

        String batchFrame = "";

        while(true){
            if(GlobalExperiment.shouldRun("PRODUCTION")){

            if(model.awaitingBatch()){

                receive batchIn; batchFrame = (String)#batchIn;

                model.activate(batchFrame);

            }

            }
            pause;

        }

    }

    ||

    {

        ProductionCoordinatorModel model = (ProductionCoordinatorModel)#stateModel;

        String event = "";

        while(true){
            if(GlobalExperiment.shouldRun("PRODUCTION")){

            event = model.takeBatchEvent();

            if(!event.equals("")){ send batchEventOut(event); }

            }
            pause;

        }

    }

    ||

    {
        ProductionCoordinatorModel model =
            (ProductionCoordinatorModel)#stateModel;

        int rotationTraceId = 0;
        String request = "";
        String done = "";

        while(true){

            if(GlobalExperiment.shouldRun("PRODUCTION")){

                if(model.requestRotation()){

                    rotationTraceId++;
                    request = "ROTATE|" + rotationTraceId;

                    System.out.println(
                        "TRACE ROTATION_REQUEST_READY" +
                        " rotation=" + rotationTraceId +
                        " request=" + request +
                        " ns=" + System.nanoTime()
                    );

                    // Synchronous rendezvous: if the controller is not ready yet,
                    // this send remains pending rather than disappearing like a signal pulse.
                    send rotationRequestOut(request);

                    System.out.println(
                        "TRACE ROTATION_REQUEST_RENDEZVOUS_COMPLETE" +
                        " rotation=" + rotationTraceId +
                        " ns=" + System.nanoTime()
                    );

                    // Wait for the correlated completion acknowledgement.
                    // The controller sends DONE|id only after physical alignment.
                    receive rotationDoneIn;
                    done = (String)#rotationDoneIn;

                    System.out.println(
                        "TRACE ROTATION_DONE_RECEIVED" +
                        " rotation=" + rotationTraceId +
                        " message=" + done +
                        " ns=" + System.nanoTime()
                    );

                    if(done.equals("DONE|" + rotationTraceId)){

                        model.aligned();

                        System.out.println(
                            "TRACE MODEL_ALIGNED_RETURNED" +
                            " rotation=" + rotationTraceId +
                            " fault=" + model.fault() +
                            " ns=" + System.nanoTime()
                        );

                        GlobalExperiment.markEvent("TABLE_ALIGNED");

                    }else{

                        // Do not commit an uncorrelated acknowledgement.
                        // The model remains in WAIT_ALIGNMENT and its existing
                        // watchdog will expose the protocol error as a timeout.
                        System.err.println(
                            "TRACE ROTATION_DONE_MISMATCH" +
                            " expected=DONE|" + rotationTraceId +
                            " actual=" + done +
                            " ns=" + System.nanoTime()
                        );
                    }
                }
            }

            pause;
        }
    }

    ||

    {

        ProductionCoordinatorModel model = (ProductionCoordinatorModel)#stateModel;

        String reason = "";

        while(true){
            if(GlobalExperiment.shouldRun("PRODUCTION")){

            receive safetyHoldIn; reason = (String)#safetyHoldIn;

            if(reason.equals("SAFETY_PERMIT_LOST_MANUAL_RECOVERY_REQUIRED")){ model.hazard(); }

            }
            pause;

        }

    }

    ||

    {

        ProductionCoordinatorModel model = (ProductionCoordinatorModel)#stateModel;

        String reset = "";

        while(true){
            if(GlobalExperiment.shouldRun("PRODUCTION")){

            receive safetyResetIn; reset = (String)#safetyResetIn;

            if(reset.equals("RESET")){

                model.reset();

                if(model.fault().equals("")){ send safetyResetDoneOut("RESET_DONE"); }

            }

            }
            pause;

        }

    }

    ||

    {

        ProductionCoordinatorModel model = (ProductionCoordinatorModel)#stateModel;

        String command = ""; String report = ""; String ack = "";

        // 0 initial/post-ACK READY; 1 pending job; 2 correlated reports.

        int stage = 0;

        while(true){
            if(GlobalExperiment.shouldRun("PRODUCTION")){

            if(stage == 0){

                receive loaderReportIn; report = (String)#loaderReportIn;

                model.ready("LOADER", report); stage = 1;

            }else if(stage == 1){

                command = model.take("LOADER");

                if(!command.equals("")){ send loaderJobOut(command); stage = 2; }

            }else if(stage == 2){

                receive loaderReportIn; report = (String)#loaderReportIn;

                ack = model.report("LOADER", report);

                if(!ack.equals("")){ send loaderAckOut(ack); GlobalExperiment.markEvent("LOADER_DONE"); stage = 0; }

                // FAULT holds the batch: no ACK or automatic bottle retry.

            }

            }
            pause;

        }

    }

    ||

    {

        ProductionCoordinatorModel model = (ProductionCoordinatorModel)#stateModel;

        String command = ""; String report = ""; String ack = "";

        // 0 initial/post-ACK READY; 1 pending job; 2 correlated reports.

        int stage = 0;

        while(true){
            if(GlobalExperiment.shouldRun("PRODUCTION")){

            if(stage == 0){

                receive conveyorReportIn; report = (String)#conveyorReportIn;

                model.ready("CONVEYOR", report); stage = 1;

            }else if(stage == 1){

                command = model.take("CONVEYOR");

                if(!command.equals("")){ send conveyorJobOut(command); stage = 2; }

            }else if(stage == 2){

                receive conveyorReportIn; report = (String)#conveyorReportIn;

                ack = model.report("CONVEYOR", report);

                if(!ack.equals("")){ send conveyorAckOut(ack); GlobalExperiment.markEvent("CONVEYOR_DONE"); stage = 0; }

                // FAULT holds the batch: no ACK or automatic bottle retry.

            }

            }
            pause;

        }

    }

    ||

    {

        ProductionCoordinatorModel model = (ProductionCoordinatorModel)#stateModel;

        String command = ""; String report = ""; String ack = "";

        // 0 initial/post-ACK READY; 1 pending job; 2 correlated reports.

        int stage = 0;

        while(true){
            if(GlobalExperiment.shouldRun("PRODUCTION")){

            if(stage == 0){

                receive fillerReportIn; report = (String)#fillerReportIn;

                model.ready("FILLER", report); stage = 1;

            }else if(stage == 1){

                command = model.take("FILLER");

                if(!command.equals("")){ send fillerJobOut(command); stage = 2; }

            }else if(stage == 2){

                receive fillerReportIn; report = (String)#fillerReportIn;

                ack = model.report("FILLER", report);

                if(!ack.equals("")){ send fillerAckOut(ack); GlobalExperiment.markEvent("FILLER_DONE"); stage = 0; }

                // FAULT holds the batch: no ACK or automatic bottle retry.

            }

            }
            pause;

        }

    }

    ||

    {

        ProductionCoordinatorModel model = (ProductionCoordinatorModel)#stateModel;

        String command = ""; String report = ""; String ack = "";

        // 0 initial/post-ACK READY; 1 pending job; 2 correlated reports.

        int stage = 0;

        while(true){
            if(GlobalExperiment.shouldRun("PRODUCTION")){

            if(stage == 0){

                receive lidReportIn; report = (String)#lidReportIn;

                model.ready("LID", report); stage = 1;

            }else if(stage == 1){

                command = model.take("LID");

                if(!command.equals("")){ send lidJobOut(command); stage = 2; }

            }else if(stage == 2){

                receive lidReportIn; report = (String)#lidReportIn;

                ack = model.report("LID", report);

                if(!ack.equals("")){ send lidAckOut(ack); GlobalExperiment.markEvent("LID_DONE"); stage = 0; }

                // FAULT holds the batch: no ACK or automatic bottle retry.

            }

            }
            pause;

        }

    }

    ||

    {

        ProductionCoordinatorModel model = (ProductionCoordinatorModel)#stateModel;

        String command = ""; String report = ""; String ack = "";

        // 0 initial/post-ACK READY; 1 pending job; 2 correlated reports.

        int stage = 0;

        while(true){
            if(GlobalExperiment.shouldRun("PRODUCTION")){

            if(stage == 0){

                receive capperReportIn; report = (String)#capperReportIn;

                model.ready("CAPPER", report); stage = 1;

            }else if(stage == 1){

                command = model.take("CAPPER");

                if(!command.equals("")){ send capperJobOut(command); stage = 2; }

            }else if(stage == 2){

                receive capperReportIn; report = (String)#capperReportIn;

                ack = model.report("CAPPER", report);

                if(!ack.equals("")){ send capperAckOut(ack); GlobalExperiment.markEvent("CAPPER_DONE"); stage = 0; }

                // FAULT holds the batch: no ACK or automatic bottle retry.

            }

            }
            pause;

        }

    }

    ||

    {

        ProductionCoordinatorModel model = (ProductionCoordinatorModel)#stateModel;

        String command = ""; String report = ""; String ack = "";

        // 0 initial/post-ACK READY; 1 pending job; 2 correlated reports.

        int stage = 0;

        while(true){
            if(GlobalExperiment.shouldRun("PRODUCTION")){

            if(stage == 0){

                receive labellerReportIn; report = (String)#labellerReportIn;

                model.ready("LABELLER", report); stage = 1;

            }else if(stage == 1){

                command = model.take("LABELLER");

                if(!command.equals("")){ send labellerJobOut(command); stage = 2; }

            }else if(stage == 2){

                receive labellerReportIn; report = (String)#labellerReportIn;

                ack = model.report("LABELLER", report);

                if(!ack.equals("")){ send labellerAckOut(ack); GlobalExperiment.markEvent("LABELLER_DONE"); stage = 0; }

                // FAULT holds the batch: no ACK or automatic bottle retry.

            }

            }
            pause;

        }

    }

    ||

    {

        ProductionCoordinatorModel model = (ProductionCoordinatorModel)#stateModel;

        String command = ""; String report = ""; String ack = "";

        // 0 initial/post-ACK READY; 1 pending job; 2 correlated reports.

        int stage = 0;

        while(true){
            if(GlobalExperiment.shouldRun("PRODUCTION")){

            if(stage == 0){

                receive unloaderReportIn; report = (String)#unloaderReportIn;

                model.ready("UNLOADER", report); stage = 1;

            }else if(stage == 1){

                command = model.take("UNLOADER");

                if(!command.equals("")){ send unloaderJobOut(command); stage = 2; }

            }else if(stage == 2){

                receive unloaderReportIn; report = (String)#unloaderReportIn;

                ack = model.report("UNLOADER", report);

                if(!ack.equals("")){ send unloaderAckOut(ack); GlobalExperiment.markEvent("UNLOADER_DONE"); stage = 0; }

                // FAULT holds the batch: no ACK or automatic bottle retry.

            }

            }
            pause;

        }

    }

}
