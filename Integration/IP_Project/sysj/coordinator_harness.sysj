// Test-only batch source. Never use instead of the actual POS at final demo.
//
// FAST AVAILABILITY MODE:
//   -Davailability.fastHarness=true
//
// skips the invalid-batch test and B1, and runs only the deterministic B2 workload.
//
// With the property absent/false, the original full acceptance sequence is preserved.

import nz.ac.auckland.eabs.zhiyuan.coordinator.IntegratedCoordinatorTest;

CoordinatorBatchHarnessCD(

    output String channel activateBatchOut;
    input String channel batchResultIn;

)->{

    String result = "";

    if(Boolean.getBoolean("availability.fastHarness")){

        // Dedicated availability workload: one deterministic two-bottle batch.
        // This is the COMMON TESTBENCH for both the centralised and decomposed DUT.
        System.out.println("AVAILABILITY FAST HARNESS: B2 only");

        send activateBatchOut("ACTIVATE|B2|R2|PRODUCT_Y|2|35|65|ORDER-EXP");

        receive batchResultIn; result = (String)#batchResultIn;

        if(!result.equals("DRAINED|B2")){ throw new IllegalStateException(result); }

        System.out.println("AVAILABILITY FAST HARNESS PASSED: 2 bottles, recipe 35/65");

        IntegratedCoordinatorTest.finishRun();

    }else{

        // Original acceptance workload, preserved exactly for regression testing.
        send activateBatchOut("ACTIVATE|BAD|R1|PRODUCT|1");

        receive batchResultIn; result = (String)#batchResultIn;

        if(!result.equals("REJECTED|BAD|INVALID_BATCH_OR_RECIPE")){ throw new IllegalStateException(result); }

        send activateBatchOut("ACTIVATE|B1|R1|PRODUCT_X|8|20|80|ORDER-1");

        receive batchResultIn; result = (String)#batchResultIn;

        if(!result.equals("DRAINED|B1")){ throw new IllegalStateException(result); }

        send activateBatchOut("ACTIVATE|B2|R2|PRODUCT_Y|2|35|65|ORDER-1");

        receive batchResultIn; result = (String)#batchResultIn;

        if(!result.equals("DRAINED|B2")){ throw new IllegalStateException(result); }

        System.out.println("COORDINATOR REAL DEVICE INTEGRATION PASSED: 8 + 2 bottles, 2 recipes, invalid batch rejected");

        IntegratedCoordinatorTest.finishRun();

    }

}


// Same actual machine/plant graph; test-only LID plant fault through the shim.

CoordinatorFaultHarnessCD(

    output String channel activateBatchOut;
    input String channel batchResultIn;

)->{

    String result = "";

    send activateBatchOut("ACTIVATE|F1|R1|PRODUCT_X|1|20|80|ORDER-F");

    receive batchResultIn; result = (String)#batchResultIn;

    if(!result.startsWith("FAULT|F1|LID_")){ throw new IllegalStateException(result); }

    System.out.println("COORDINATOR REAL DEVICE FAULT HOLD PASSED: " + result);

    IntegratedCoordinatorTest.finishRun();

}
