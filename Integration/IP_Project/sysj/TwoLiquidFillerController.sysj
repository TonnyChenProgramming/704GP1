TwoLiquidFillerController(

    input String channel commandIn;
    output String channel reportOut;
    input String channel ackIn;

    output Integer channel dose1;
    output Integer channel dose2;

    input Boolean channel bottlePresent;
    input Boolean channel dose1Done;
    input Boolean channel dose2Done;
    input Boolean channel overflow;

    input Integer channel currentAmountA;
    input Integer channel currentAmountB;

)->{

    int stage = 0;

    String jobId = "";
    String workpieceId = "";

    int target1 = 0;
    int target2 = 0;

    int actual1 = 0;
    int actual2 = 0;

    send reportOut("READY|FILLER");

    while(true){

        if(stage == 0){

            receive commandIn;
            String command = (String)#commandIn;

            int p1 = command.indexOf("|");
            int p2 = command.indexOf("|", p1 + 1);
            int p3 = command.indexOf("|", p2 + 1);
            int p4 = command.indexOf("|", p3 + 1);
            int p5 = command.indexOf("|", p4 + 1);
            int p6 = command.indexOf("|", p5 + 1);

            jobId = command.substring(p1 + 1, p2);
            workpieceId = command.substring(p2 + 1, p3);

            target1 = Integer.parseInt(
                command.substring(p5 + 1, p6)
            );

            target2 = Integer.parseInt(
                command.substring(p6 + 1)
            );

            actual1 = 0;
            actual2 = 0;

            System.out.println(
                "START received for " + workpieceId
            );

            stage = 1;

        }else if(stage == 1){

            receive bottlePresent;

            if((Boolean)#bottlePresent){

                send reportOut(
                    "BUSY|" + jobId + "|" +
                    workpieceId + "|FILLER"
                );

                stage = 2;

            }else{

                send reportOut(
                    "FAULT|" + jobId + "|" +
                    workpieceId +
                    "|FILLER|NO_BOTTLE_PRESENT"
                );

                stage = 0;
            }

        }else if(stage == 2){

            send dose1(target1);
            stage = 3;

        }else if(stage == 3){

            receive dose1Done;

            if((Boolean)#dose1Done){

                receive currentAmountA;
                actual1 = (Integer)#currentAmountA;

                stage = 4;

            }else{

                send reportOut(
                    "FAULT|" + jobId + "|" +
                    workpieceId +
                    "|FILLER|DOSE1_NOT_DONE"
                );

                stage = 0;
            }

        }else if(stage == 4){

            send dose2(target2);
            stage = 5;

        }else if(stage == 5){

            receive dose2Done;

            if((Boolean)#dose2Done){

                receive currentAmountB;
                actual2 = (Integer)#currentAmountB;

                stage = 6;

            }else{

                send reportOut(
                    "FAULT|" + jobId + "|" +
                    workpieceId +
                    "|FILLER|DOSE2_NOT_DONE"
                );

                stage = 0;
            }

        }else if(stage == 6){

            receive overflow;

            if((Boolean)#overflow){

                send reportOut(
                    "FAULT|" + jobId + "|" +
                    workpieceId +
                    "|FILLER|OVERFLOW"
                );

                stage = 0;

            }else{

                send reportOut(
                    "DONE|" + jobId + "|" +
                    workpieceId +
                    "|FILLER|OK|liquidA=" +
                    actual1 +
                    "|liquidB=" +
                    actual2
                );

                stage = 7;
            }

        }else if(stage == 7){

            receive ackIn;
            send reportOut("READY|FILLER");
            stage = 0;
        }

        pause;
    }
}