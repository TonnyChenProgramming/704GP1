TwoLiquidFillerPlant(

    input Integer channel dose1;
    input Integer channel dose2;

    output Boolean channel bottlePresent;
    output Boolean channel dose1Done;
    output Boolean channel dose2Done;
    output Boolean channel overflow;

)->{

    int currentLevel = 0;

    while(true){

        send bottlePresent(true);

        receive dose1;
        currentLevel += (Integer)#dose1;

        System.out.println(
            "Plant: liquid 1 filled"
        );

        waitl(500 ms);
        send dose1Done(true);

        receive dose2;
        currentLevel += (Integer)#dose2;

        System.out.println(
            "Plant: liquid 2 filled"
        );

        waitl(500 ms);
        send dose2Done(true);

        send overflow(currentLevel > 100);

        currentLevel = 0;
        pause;
    }
}