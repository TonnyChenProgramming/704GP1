/*
 * coordinator.sysj -- Production Coordinator (Coordinator_Spec.md; GP report
 * Figure 1/2, Table 4).
 *
 * This project (CoordinatorSystemJ/) is a stripped-down, compiler-ready
 * companion to the main ip-persistence/704GP1/Zhiyuan/ module: it carries
 * only this .sysj file and its XML wiring (no plain-Java classes are
 * imported here any more -- see the Tracker note below for why). The full
 * Java-side implementation this file was translated from --
 * nz.ac.auckland.eabs.zhiyuan.coordinator.Coordinator, whose 5 acceptance
 * scenarios pass against stub controllers, see
 * 704GP1/Zhiyuan/src/test/.../CoordinatorAcceptanceTest.java -- lives in
 * that other project, not here; the control logic below mirrors it exactly.
 *
 * STATUS: this file has never been run through the SystemJ compiler (sjc)
 * -- no SystemJ toolchain was available on the machine it was written on.
 * That's what this project is for: compile it here (BuildAll.launch, then
 * RunCoordinator.launch) and fix whatever syntax issues surface. Syntax
 * here is grounded in real, already-compiled course/group examples --
 * COMPSYS704_Lab_2/sysj/Exercise6.sysj (channel send/receive, the `{A}||{B}`
 * synchronous-join pattern used below to wait for several stations at once),
 * COMPSYS704_Lab_3/sysj/controller.sysj (the abort/trap main-sequence
 * pattern, sustain, boolean signal expressions like `!enable`), and Eric's
 * own 704GP1/Eric/systemj/finishing_contract.sysj (the pipe-delimited
 * String channel protocol reused below so this interoperates with his four
 * already-delivered finishing controllers without a re-encoding) -- but
 * none of that guarantees it compiles as-is.
 *
 * Per Coordinator_SystemI_Spec.md Section 7's "definition of done", every
 * station Controller wired here is a stub -- simple canned
 * READY/BUSY/DONE/FAULT responders -- not Tonny's real Loader/Filler (not
 * yet delivered) and not Eric's real Lid/Capper/Labeller/Unloader
 * (delivered, but not wired in yet). Wiring real controllers in is the next
 * phase.
 *
 * BatchManager (com.g7.ip.BatchManager) stays plain, synchronous Java per
 * the IP report's Stage-1 plan. ActivateBatch/BatchDrained are modelled
 * here as a channel pair (SystemJ_Reference.md's own classification for
 * command/ack pairs) -- BatchManagerHarnessCD below stands in for a real
 * bridge CD that would translate these channel events into direct calls
 * into the existing BatchManager.start()/onBatchDrained()/
 * CoordinatorLink.activateBatch() Java methods; that bridge is not written
 * here (a follow-up, not Coordinator's own concern).
 *
 * TRACKER CALLS ARE TEMPORARILY REMOVED (2026-09-12). The original design
 * called TrackerPort/StubTracker as a plain Java object held by the
 * Coordinator CD (GP report Figure 3's Controller/Model pairing). That
 * crashes this SystemJ compiler: `import
 * nz.ac.auckland.eabs.zhiyuan.coordinator.TrackerPort;` plus using it as a
 * field/signal type and calling its methods reproducibly triggers
 *   java.lang.NullPointerException: Cannot invoke "java.util.ArrayList.iterator()"
 *   because "AST.ClassFile.sourcePath" is null
 * in an isolated minimal repro -- tried both an interface-typed field
 * (`TrackerPort tracker = new StubTracker();`) and, matching Eric's own
 * proven `FinishingCycle signal cycleModel; emit cycleModel(new
 * FinishingCycle(...)); pause; ... (FinishingCycle)#cycleModel` pattern
 * exactly but with the concrete `StubTracker` class instead of the
 * interface, and got the identical crash both times. Root cause not
 * understood yet (possibly specific to how/whether TrackerPort.java and
 * StubTracker.java have ever been compiled to .class in this project, or
 * something else about those two files specifically -- not yet isolated
 * further). Every `tracker.*` call below is replaced with a
 * `System.out.println(...)` of the same information, so the state
 * machine's logic and control flow are unchanged and still observable on
 * the console. The real Tracker integration is unaffected elsewhere: it
 * stays verified in the Java-only nz.ac.auckland.eabs.zhiyuan.coordinator
 * package (704GP1/Zhiyuan/src/, a separate project from this one) via
 * CoordinatorAcceptanceTest.java, which never went through this compiler.
 * Revisit once this file's control flow alone is confirmed to compile/run.
 */

CoordinatorCD(
    input  String channel activateBatchIn;   // "ACTIVATE|batchId|recipeId|productId|totalQuantity"
    output String channel batchDrainedOut;   // "DRAINED|batchId"

    output String channel loaderJobOut;    input String channel loaderReportIn;    output String channel loaderAckOut;
    output String channel fillerJobOut;    input String channel fillerReportIn;    output String channel fillerAckOut;
    output String channel lidJobOut;       input String channel lidReportIn;       output String channel lidAckOut;
    output String channel capperJobOut;    input String channel capperReportIn;    output String channel capperAckOut;
    output String channel labellerJobOut;  input String channel labellerReportIn;  output String channel labellerAckOut;
    output String channel unloaderJobOut;  input String channel unloaderReportIn;  output String channel unloaderAckOut;

    // Rotary Table Controller: continuous-drive signal pair, matching brief
    // Appendix 4's own idiom for this exact device ("rotaryTableTrigger ...
    // turns the rotary table while [it is] true").
    output signal rotateTrigger;
    input  signal tableAligned;

    // Safety Monitor CD -- broadcast signal, not a channel (SystemJ_Reference.md).
    input signal safetyPermitLost;
)->{
    // ---- shared CD state (index 0 unused; 1..5 usable, position 6 reserved/unused per brief Appendix 4) ----
    String[] rotaryOccupant = new String[6];
    String labellerOccupant = null;
    String unloaderOccupant = null;
    String batchId = null, recipeId = null, productId = null;
    int totalQuantity = 0, admitted = 0, completed = 0, nextSeq = 0;

    // Internal local signals (Coordinator_SystemI_Spec.md Section 3.2: reactions
    // communicate via internal local signals, not channels -- channels are for
    // inter-CD boundaries only).
    signal batchActive, batchDrainedLocal;

    {
        // -------- Reaction 1: WAIT_ORDER (order/batch activation) --------
        while(true){
            receive activateBatchIn;
            String msg = (String)#activateBatchIn;
            // Manual indexOf/substring parsing, not .split() -- .split() returning
            // an array assigned straight into a local (`Type[] x = expr;`) crashes
            // this SystemJ compiler's field-hoisting step (emits an invalid `..`
            // field type). Tonny's real controllers already parse this way.
            int msgP1 = msg.indexOf("|");
            int msgP2 = msg.indexOf("|", msgP1 + 1);
            int msgP3 = msg.indexOf("|", msgP2 + 1);
            int msgP4 = msg.indexOf("|", msgP3 + 1);
            batchId = msg.substring(msgP1 + 1, msgP2);
            recipeId = msg.substring(msgP2 + 1, msgP3);
            productId = msg.substring(msgP3 + 1, msgP4);
            totalQuantity = Integer.parseInt(msg.substring(msgP4 + 1));
            admitted = 0; completed = 0; nextSeq = 0;
            for (int p = 1; p <= 5; p++){ rotaryOccupant[p] = null; }
            labellerOccupant = null; unloaderOccupant = null;
            emit batchActive;
            await(batchDrainedLocal);
        }
    }
    ||
    {
        // -------- Reaction 2: PREPARE_BATCH .. UPDATE_CONFIRMED_POSITIONS,
        // preempted by a safety hazard (Coordinator_Spec.md Section 6). --------
        while(true){
            await(batchActive);
            weak abort(safetyPermitLost){
                while(admitted < totalQuantity || rotaryOccupant[1] != null || rotaryOccupant[2] != null
                        || rotaryOccupant[3] != null || rotaryOccupant[4] != null || rotaryOccupant[5] != null
                        || labellerOccupant != null || unloaderOccupant != null){

                    // ---- PREPARE_BATCH ----
                    // The loader always places a bottle at rotary position 1 specifically --
                    // admitting a new one while P1 is occupied would overwrite whatever bottle
                    // is sitting there (this exact bug was found and fixed in Coordinator.java's
                    // Java version -- see that class's tickPrepareBatch() comment).
                    if (admitted < totalQuantity && rotaryOccupant[1] == null){
                        nextSeq++;
                        String wp = "WP-" + batchId + "-" + nextSeq;
                        String jobId = "J-" + wp + "-LOAD";
                        send loaderJobOut("START|" + jobId + "|" + wp + "|LOADER|LOAD_BOTTLE");
                        receive loaderReportIn; // BUSY
                        receive loaderReportIn; // DONE or FAULT
                        String rep = (String)#loaderReportIn;
                        if (rep.startsWith("DONE")){
                            System.out.println("TRACKER createTwin " + wp + " batch=" + batchId);
                            rotaryOccupant[1] = wp;
                            System.out.println("TRACKER confirmLocation " + wp + " ROTARY_P1");
                            send loaderAckOut("ACK|" + jobId + "|" + wp);
                            admitted++;
                        } else {
                            System.out.println("TRACKER setStatus " + wp + " FAULT");
                        }
                    }

                    // ---- DISPATCH_OPERATIONS + WAIT_REQUIRED_COMPLETIONS ----
                    // Each branch is a no-op if its position/slot is empty. The `{...}||{...}`
                    // join below only continues past this block once EVERY branch has finished
                    // (including the ones that did nothing) -- this is the same
                    // "synchronously await several things at once" pattern used in
                    // COMPSYS704_Lab_2/sysj/Exercise6.sysj's Pabro reaction
                    // (`{await (A);} || {await (B);}`), so it correctly reproduces
                    // Coordinator.java's "wait for every dispatched station to report DONE
                    // before indexing" rule without polling.
                    boolean fillerFaulted = false, lidFaulted = false, capperFaulted = false,
                            labellerFaulted = false, unloaderFaulted = false;
                    {
                        if (rotaryOccupant[2] != null){
                            String wp = rotaryOccupant[2];
                            String jobId = "J-" + wp + "-FILLER";
                            send fillerJobOut("START|" + jobId + "|" + wp + "|FILLER|FILL_TWO_LIQUIDS");
                            receive fillerReportIn;
                            receive fillerReportIn;
                            String rep = (String)#fillerReportIn;
                            if (rep.startsWith("DONE")){
                                System.out.println("TRACKER confirmOperation " + wp + " FILLER");
                                send fillerAckOut("ACK|" + jobId + "|" + wp);
                            } else {
                                System.out.println("TRACKER setStatus " + wp + " FAULT");
                                fillerFaulted = true;
                            }
                        }
                    }
                    ||
                    {
                        if (rotaryOccupant[3] != null){
                            String wp = rotaryOccupant[3];
                            String jobId = "J-" + wp + "-LID";
                            send lidJobOut("START|" + jobId + "|" + wp + "|LID|PLACE_LID");
                            receive lidReportIn;
                            receive lidReportIn;
                            String rep = (String)#lidReportIn;
                            if (rep.startsWith("DONE")){
                                System.out.println("TRACKER confirmOperation " + wp + " LID");
                                send lidAckOut("ACK|" + jobId + "|" + wp);
                            } else {
                                System.out.println("TRACKER setStatus " + wp + " FAULT");
                                lidFaulted = true;
                            }
                        }
                    }
                    ||
                    {
                        if (rotaryOccupant[4] != null){
                            String wp = rotaryOccupant[4];
                            String jobId = "J-" + wp + "-CAPPER";
                            send capperJobOut("START|" + jobId + "|" + wp + "|CAPPER|CAP_BOTTLE");
                            receive capperReportIn;
                            receive capperReportIn;
                            String rep = (String)#capperReportIn;
                            if (rep.startsWith("DONE")){
                                System.out.println("TRACKER confirmOperation " + wp + " CAPPER");
                                send capperAckOut("ACK|" + jobId + "|" + wp);
                            } else {
                                System.out.println("TRACKER setStatus " + wp + " FAULT");
                                capperFaulted = true;
                            }
                        }
                    }
                    ||
                    {
                        if (labellerOccupant != null){
                            String wp = labellerOccupant;
                            String jobId = "J-" + wp + "-LABELLER";
                            send labellerJobOut("START|" + jobId + "|" + wp + "|LABELLER|APPLY_LABEL");
                            receive labellerReportIn;
                            receive labellerReportIn;
                            String rep = (String)#labellerReportIn;
                            if (rep.startsWith("DONE")){
                                System.out.println("TRACKER confirmOperation " + wp + " LABELLER");
                                send labellerAckOut("ACK|" + jobId + "|" + wp);
                            } else {
                                System.out.println("TRACKER setStatus " + wp + " FAULT");
                                labellerFaulted = true;
                            }
                        }
                    }
                    ||
                    {
                        if (unloaderOccupant != null){
                            String wp = unloaderOccupant;
                            String jobId = "J-" + wp + "-UNLOADER";
                            send unloaderJobOut("START|" + jobId + "|" + wp + "|UNLOADER|UNLOAD");
                            receive unloaderReportIn;
                            receive unloaderReportIn;
                            String rep = (String)#unloaderReportIn;
                            if (rep.startsWith("DONE")){
                                System.out.println("TRACKER confirmOperation " + wp + " UNLOADER");
                                send unloaderAckOut("ACK|" + jobId + "|" + wp);
                            } else {
                                System.out.println("TRACKER setStatus " + wp + " FAULT");
                                unloaderFaulted = true;
                            }
                        }
                    }

                    boolean anyFaulted = fillerFaulted || lidFaulted || capperFaulted
                            || labellerFaulted || unloaderFaulted;

                    if (!anyFaulted){
                        // ---- INDEX_TABLE ----
                        // Output-position guard (brief Appendix 4 / Coordinator_Spec.md Section
                        // 2: "must NOT move ... while the output position is blocked"). Since
                        // every occupied station above is now resolved (guaranteed by
                        // !anyFaulted), this only ever fires if P5 holds a bottle that was never
                        // dispatched at all this cycle -- see Coordinator.java's tickIndexTable()
                        // for the equivalent, already-debugged guard (an earlier raw-occupancy
                        // version of this check deadlocked permanently; checking against this
                        // cycle's resolution status, as here, is what fixed it).
                        if (!(rotaryOccupant[5] != null && labellerOccupant != null)){
                            emit rotateTrigger;
                            await(tableAligned);

                            // ---- UPDATE_CONFIRMED_POSITIONS ----
                            // Downstream completions free slots first, so a same-cycle handoff
                            // from the table can use them (same ordering as Coordinator.java).
                            if (unloaderOccupant != null){
                                System.out.println("TRACKER confirmLocation " + unloaderOccupant + " OUTPUT_COLLECTION");
                                completed++;
                                unloaderOccupant = null;
                            }
                            if (labellerOccupant != null && unloaderOccupant == null){
                                unloaderOccupant = labellerOccupant;
                                System.out.println("TRACKER confirmLocation " + unloaderOccupant + " UNLOADER");
                                labellerOccupant = null;
                            }
                            if (rotaryOccupant[5] != null && labellerOccupant == null){
                                labellerOccupant = rotaryOccupant[5];
                                System.out.println("TRACKER confirmLocation " + labellerOccupant + " LABELLER");
                                rotaryOccupant[5] = null;
                            }
                            for (int p = 4; p >= 1; p--){
                                if (rotaryOccupant[p] != null && rotaryOccupant[p + 1] == null){
                                    rotaryOccupant[p + 1] = rotaryOccupant[p];
                                    rotaryOccupant[p] = null;
                                    System.out.println("TRACKER confirmLocation " + rotaryOccupant[p + 1] + " ROTARY_P" + (p + 1));
                                }
                            }
                        }
                    }
                    pause;
                }
            }
            // Control resumes here immediately once safetyPermitLost preempted the body above
            // (weak abort: the branch mid-actuation at that instant finishes its current
            // send/receive pair first, matching "Controllers finish only the actuator action
            // required to reach their safe condition"). Reaction 3 below owns SAFE_HOLD
            // bookkeeping; this reaction simply re-loops to await(batchActive) once the batch
            // (still active, now short some discarded/rolled-back bottles) needs to resume.
            if (admitted == totalQuantity && completed == totalQuantity){
                send batchDrainedOut("DRAINED|" + batchId);
                emit batchDrainedLocal;
            }
        }
    }
    ||
    {
        // -------- Reaction 3: safety coordination (Coordinator_Spec.md Section 6) --------
        while(true){
            await(safetyPermitLost);
            // Discard every in-flight bottle and roll back `admitted` so PREPARE_BATCH admits
            // fresh replacements once recovered -- mirrors Coordinator.java's enterSafeHold()
            // (see that method's comment for why the rollback is required: otherwise the batch
            // could never reach total_quantity again once bottles are discarded).
            int discarded = 0;
            for (int p = 1; p <= 5; p++){
                if (rotaryOccupant[p] != null){
                    System.out.println("TRACKER setStatus " + rotaryOccupant[p] + " ABORTED");
                    rotaryOccupant[p] = null;
                    discarded++;
                }
            }
            if (labellerOccupant != null){
                System.out.println("TRACKER setStatus " + labellerOccupant + " ABORTED");
                labellerOccupant = null;
                discarded++;
            }
            if (unloaderOccupant != null){
                System.out.println("TRACKER setStatus " + unloaderOccupant + " ABORTED");
                unloaderOccupant = null;
                discarded++;
            }
            admitted = admitted - discarded;

            await(!safetyPermitLost);
            // TODO(open item): Coordinator_Spec.md Section 6 also requires an explicit operator
            // acknowledgement before resuming ("hazard cleared + operator acknowledgement +
            // safetyPermit restored"), matching Coordinator.java's acknowledgeSafetyClear()/
            // operatorAcknowledged flag. This draft only reconstructs !safetyPermitLost -- add a
            // second input signal (name TBD with the group) and
            // `await(!safetyPermitLost); await(operatorAcknowledge);` once agreed.
        }
    }
}

/*
 * ---------------------------------------------------------------------
 * Stub station Controller CDs -- canned READY/BUSY/DONE/FAULT responders,
 * one bottle at a time, matching Eric's LidLoaderControllerCD pattern
 * (704GP1/Eric/systemj/finishing_contract.sysj) exactly, generalised to all
 * six stations. Per Coordinator_SystemI_Spec.md Section 7 these stand in
 * for both Tonny's not-yet-delivered Loader/Filler and Eric's delivered-
 * but-not-yet-wired Lid/Capper/Labeller/Unloader.
 * ---------------------------------------------------------------------
 */

LoaderControllerCD(
    input  String channel jobIn;
    output String channel reportOut;
    input  String channel ackIn;
)->{
    // Job format sent by CoordinatorCD: "START|jobId|workpieceId|STATION|OPERATION"
    // (Eric's docs/INTEGRATION.md protocol) -- parsed inline rather than via a
    // separate helper function/method, since no verified course example shows
    // auxiliary method declarations inside a CD body.
    String job = "";
    send reportOut("READY|LOADER");
    while(true){
        receive jobIn;
        job = (String)#jobIn;
        // Manual indexOf/substring, not .split() -- see Reaction 1's comment above
        // for why (.split() into a local array crashes this compiler's codegen).
        int jobP1 = job.indexOf("|");
        int jobP2 = job.indexOf("|", jobP1 + 1);
        int jobP3 = job.indexOf("|", jobP2 + 1);
        String jobId = job.substring(jobP1 + 1, jobP2);
        String wp = job.substring(jobP2 + 1, jobP3);
        send reportOut("BUSY|" + jobId + "|" + wp + "|LOADER");
        pause;
        send reportOut("DONE|" + jobId + "|" + wp + "|LOADER|OK|bottlePlaced=true");
        receive ackIn;
        send reportOut("READY|LOADER");
    }
}

FillerControllerCD(
    input  String channel jobIn;
    output String channel reportOut;
    input  String channel ackIn;
)->{
    String job = "";
    send reportOut("READY|FILLER");
    while(true){
        receive jobIn;
        job = (String)#jobIn;
        // Manual indexOf/substring, not .split() -- see Reaction 1's comment above
        // for why (.split() into a local array crashes this compiler's codegen).
        int jobP1 = job.indexOf("|");
        int jobP2 = job.indexOf("|", jobP1 + 1);
        int jobP3 = job.indexOf("|", jobP2 + 1);
        String jobId = job.substring(jobP1 + 1, jobP2);
        String wp = job.substring(jobP2 + 1, jobP3);
        send reportOut("BUSY|" + jobId + "|" + wp + "|FILLER");
        pause;
        send reportOut("DONE|" + jobId + "|" + wp + "|FILLER|OK|liquidA=0.5|liquidB=0.5");
        receive ackIn;
        send reportOut("READY|FILLER");
    }
}

