// Availability experiment version: EVENT-ALIGNED-V4-2026-09-13
// Batch lifecycle split from the frozen centralised CoordinatorCD.
// SystemJ owns inter-CD communication; BatchCoordinatorModel owns batch state.

import nz.ac.auckland.eabs.zhiyuan.coordinator.BatchCoordinatorModel;
import nz.ac.auckland.eabs.zhiyuan.coordinator.GlobalExperiment;

BatchCoordinatorCD(

    input String channel activateBatchIn;

    output String channel batchDrainedOut;

    output String channel productionBatchOut;

    input String channel productionEventIn;

    input String channel safetyResetIn;

)->{

    BatchCoordinatorModel signal stateModel;

    emit stateModel(new BatchCoordinatorModel());

    pause;

    // Out-of-band BATCH-local experiment clock. This reaction is NEVER halted.
    // It advances once per BatchCoordinatorCD logical instant.
    {
        while(true){
            GlobalExperiment.clockTick("BATCH");
            pause;
        }
    }
    ||

    {

        BatchCoordinatorModel model = (BatchCoordinatorModel)#stateModel;

        String batchFrame = "";

        String productionFrame = "";

        while(true){
            if(GlobalExperiment.shouldRun("BATCH")){

            if(model.awaitingOrder()){

                receive activateBatchIn; batchFrame = (String)#activateBatchIn;

                model.activate(batchFrame);

                productionFrame = model.productionFrame();

                if(!productionFrame.equals("")){ GlobalExperiment.arm(productionFrame); GlobalExperiment.markEvent("BATCH_ACCEPTED"); send productionBatchOut(productionFrame); }

            }

            }
            pause;

        }

    }

    ||

    {

        BatchCoordinatorModel model = (BatchCoordinatorModel)#stateModel;

        String result = "";

        while(true){
            if(GlobalExperiment.shouldRun("BATCH")){

            result = model.response();
            // Log completion before the synchronous DRAINED rendezvous. The receiver may
            // finish the acceptance harness immediately after the send succeeds.

            if(!result.equals("")){
                GlobalExperiment.recordBatchResult(result);
                send batchDrainedOut(result);
                model.responseSent();
                GlobalExperiment.exitIfRequested();
            }

            }
            pause;

        }

    }

    ||

    {

        BatchCoordinatorModel model = (BatchCoordinatorModel)#stateModel;

        String event = "";

        while(true){
            if(GlobalExperiment.shouldRun("BATCH")){

            receive productionEventIn; event = (String)#productionEventIn;

            model.productionEvent(event);

            }
            pause;

        }

    }

    ||

    {

        BatchCoordinatorModel model = (BatchCoordinatorModel)#stateModel;

        String reset = "";

        while(true){
            if(GlobalExperiment.shouldRun("BATCH")){

            receive safetyResetIn; reset = (String)#safetyResetIn;

            if(reset.equals("RESET")){ model.reset(); }

            }
            pause;

        }

    }

}
