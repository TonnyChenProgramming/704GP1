Controller2(
		input signal pusherRetracted,pusherExtended,WPgripped,armAtSource,armAtDest,empty,request;
		output signal pusherExtend,vacOn,armSource,armDest;
		input Integer signal mode;
		input signal pusherExtendM,vacOnM,armSourceM,armDestM;
		)
->{
/* TODO: Write control-logic */
	Integer signal state;
	/* 0 - idle, 1 - arm extend, 2 - pusher extend, 3 - pusher retract, 4 - arm source, 5 - sucker gripple
	 * 6 - arm extend, 7 - sucker release , then back to 2
	 */
	emit state(0);
	pause;
	{
		/* Moore Machine switching */
		{while (true){if ((Integer)#state == 0) {present(request && !empty){emit state(1);}} pause;}}
		||
		{while (true){if ((Integer)#state == 1) {present(armAtDest){emit state(2);}} pause;}}
		||
		{while (true){if ((Integer)#state == 2) {present(pusherExtended){emit state(3);}} pause;}}
		||
		{while (true){if ((Integer)#state == 3) {present(pusherRetracted){emit state(4);}} pause;}}
		||
		{while (true){if ((Integer)#state == 4) {present(armAtSource){emit state(5);}} pause;}}
		||
		{while (true){if ((Integer)#state== 5) {present(WPgripped){emit state(6);}} pause;}}
		||
		{while (true){if ((Integer)#state == 6) {present(armAtDest){emit state(7);}} pause;}}
		||
		{while (true){if ((Integer)#state == 7) {present(!WPgripped && !empty){emit state(2);}} pause;}}
		
	}
		
	||
		/* Moore Machine Action */
	{
		
		{while (true) {if ((Integer)#state != 4 && (Integer)#state != 5 ) {emit armDest;} pause;}}/*armDest signal*/
		||
		{while (true) {if ((Integer)#state == 5 | (Integer)#state == 6) {emit vacOn;} pause;}}/*vacOn signal*/
		||
		{while (true) {if ((Integer)#state == 4 | (Integer)#state == 5) {emit armSource;} pause;}}/*armSource signal*/
		||
		{while (true) {if ((Integer)#state == 2) {emit pusherExtend;} pause;}} /*pusher Extend signal*/
	}
}
