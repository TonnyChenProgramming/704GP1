<System xmlns="http://systemjtechnology.com">
    <SubSystem Name="ConveyorSubsystem" Local="true">
        <ClockDomain Name="ConveyorControllerCD" Class="ConveyorController">
            <iChannel Name="commandIn" From="CoordinatorCD.conveyorJobOut"/>
            <oChannel Name="reportOut" To="CoordinatorCD.conveyorReportIn"/>
            <iChannel Name="ackIn" From="CoordinatorCD.conveyorAckOut"/>
            <oChannel Name="motorRun" To="ConveyorPlantCD.motorRun"/>
            <iChannel Name="photoEye" From="ConveyorPlantCD.photoEye"/>
            <iChannel Name="bottleLeft" From="ConveyorPlantCD.bottleLeft"/>
        </ClockDomain>

        <ClockDomain Name="ConveyorPlantCD" Class="ConveyorPlant">
            <iChannel Name="motorRun" From="ConveyorControllerCD.motorRun"/>
            <oChannel Name="photoEye" To="ConveyorControllerCD.photoEye"/>
            <oChannel Name="bottleLeft" To="ConveyorControllerCD.bottleLeft"/>
        </ClockDomain>

    </SubSystem>

</System>