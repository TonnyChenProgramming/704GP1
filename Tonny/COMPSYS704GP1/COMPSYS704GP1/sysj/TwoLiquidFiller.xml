<System xmlns="http://systemjtechnology.com">

	<SubSystem Name="TwoLiquidFillerSubsystem" Local="true">

		<ClockDomain Name="TwoLiquidFillerControllerCD" Class="TwoLiquidFillerController">
            <oChannel Name="valve1" To="TwoLiquidFillerPlantCD.valve1"/>
            <oChannel Name="valve2" To="TwoLiquidFillerPlantCD.valve2"/>
            <iChannel Name="bottlePresent" From="TwoLiquidFillerPlantCD.bottlePresent"/>
            <iChannel Name="amount1" From="TwoLiquidFillerPlantCD.amount1"/>
            <iChannel Name="amount2" From="TwoLiquidFillerPlantCD.amount2"/>
            <iChannel Name="level" From="TwoLiquidFillerPlantCD.level"/>
            <iChannel Name="overflow" From="TwoLiquidFillerPlantCD.overflow"/>
		</ClockDomain>

		<ClockDomain Name="TwoLiquidFillerPlantCD" Class="TwoLiquidFillerPlant">
            <iChannel Name="valve1" From="TwoLiquidFillerControllerCD.valve1"/>
            <iChannel Name="valve2" From="TwoLiquidFillerControllerCD.valve2"/>
            <oChannel Name="bottlePresent" To="TwoLiquidFillerControllerCD.bottlePresent"/>
            <oChannel Name="amount1" To="TwoLiquidFillerControllerCD.amount1"/>
            <oChannel Name="amount2" To="TwoLiquidFillerControllerCD.amount2"/>
            <oChannel Name="level" To="TwoLiquidFillerControllerCD.level"/>
            <oChannel Name="overflow" To="TwoLiquidFillerControllerCD.overflow"/>
		</ClockDomain>

	</SubSystem>

</System>